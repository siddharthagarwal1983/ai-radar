# Set the key for whichever provider the models in config/profile.yaml point at.
# LiteLLM reads these directly; only the one you use is required.

# Gemini via Vertex AI (current) needs NO key here — it uses Application Default
# Credentials: gcloud auth application-default login

# Gemini via the public API (free tier: 20 requests/day/model)
GEMINI_API_KEY=

# OPENAI_API_KEY=sk-...        # real OpenAI keys start with sk-
# ANTHROPIC_API_KEY=sk-ant-...

# Deepgram is a speech API (STT/TTS), not an LLM provider — it cannot serve GPT or
# any chat model. Kept here for future speech work, unused by the digest pipeline.
DEEPGRAM_API_KEY=
